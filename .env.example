# AURA 100% Free-Tier Deployment Environment Configuration
ENVIRONMENT=production

# 1. Supabase Postgres Free Tier Link
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_SUPABASE_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres

# 2. Upstash Redis Free Tier Link
REDIS_URL=rediss://default:[YOUR_UPSTASH_TOKEN]@global-[YOUR_ENDPOINT].upstash.io:6379

# 3. Google Gemini Free Tier API Key (obtain from aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# 4. Security Keys
SECRET_KEY=generate_a_random_32_character_signing_key_here

# 5. Local Storage Directories (adjust to absolute paths in production)
UPLOAD_DIR=./backend/data/uploads
DUCKDB_PATH=./backend/data/duckdb/aura_analytics.db
